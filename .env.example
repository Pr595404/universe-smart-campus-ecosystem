# Copy to .env and set a unique JWT_SECRET (at least 32 random characters).
PORT=5000
JWT_SECRET=replace-this-with-a-random-secret-of-at-least-32-characters
DB_PATH=./database/universe.db

# Optional external AI keys. Leave empty to use the built-in demo response.
OPENAI_API_KEY=
GEMINI_API_KEY=

# Optional local demo-role passwords. Set before the first database initialization.
DEMO_STUDENT_PASSWORD=
DEMO_TEACHER_PASSWORD=
DEMO_ADMIN_PASSWORD=
